-- Execute with psql -X -f as administrator, connected to the postgres database.
-- Do not use --single-transaction: CREATE DATABASE requires autocommit.
\set ON_ERROR_STOP on
\set ECHO none
SELECT pg_advisory_lock(74211, 1);

SELECT EXISTS (
    SELECT 1 FROM pg_database
    WHERE datname = 'singflow' AND pg_get_userbyid(datdba) <> 'singflow'
) AS incompatible_database \gset
\if :incompatible_database
    \echo 'ERRO: banco singflow pertence a outro usuario. Revise com o administrador; nenhuma propriedade sera alterada.'
    \quit 3
\endif

SELECT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'singflow') AS role_exists \gset
\if :role_exists
    SELECT rolcanlogin AND NOT rolsuper AND NOT rolcreatedb AND NOT rolcreaterole
           AND NOT rolreplication AND NOT rolbypassrls AS compatible_role
    FROM pg_roles WHERE rolname = 'singflow' \gset
    \if :compatible_role
        \echo 'Usuario singflow existente preservado, inclusive a senha.'
    \else
        \echo 'ERRO: usuario singflow possui atributos diferentes dos esperados. Revise com o administrador; nada sera alterado automaticamente.'
        \quit 3
    \endif
\else
    CREATE ROLE singflow LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
    \echo 'Defina a senha do usuario PostgreSQL singflow no prompt seguro abaixo.'
    \password singflow
\endif

SELECT format('CREATE DATABASE %I OWNER %I TEMPLATE template0 ENCODING %L', 'singflow', 'singflow', 'UTF8')
WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = 'singflow')
\gexec

SELECT datname, pg_get_userbyid(datdba) AS owner
FROM pg_database WHERE datname = 'singflow';
SELECT pg_advisory_unlock(74211, 1);
\echo 'Preparacao concluida. Conecte como singflow e inicie o backend para aplicar o Flyway.'
