{
  "name": "singflow-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "playwright test",
    "prestart": "node scripts/configure.mjs",
    "prebuild": "node scripts/configure.mjs",
    "prewatch": "node scripts/configure.mjs",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src scripts *.json *.ts",
    "format": "prettier --write src scripts *.json *.ts",
    "test:config": "node --experimental-strip-types --test scripts/configure.test.mjs"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/cdk": "22.2.5",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@fontsource-variable/manrope": "5.3.0",
    "@primeuix/themes": "3.1.0",
    "primeicons": "8.0.2",
    "primeng": "22.1.4",
    "qrcode": "1.5.4",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/qrcode": "1.5.6",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "tailwindcss-primeui": "0.6.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
