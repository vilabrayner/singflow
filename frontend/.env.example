# Modelo específico do frontend; bloco completo em ../.env.example.
# Variáveis do processo prevalecem sobre frontend/.env. Não copiar credenciais do backend.
# npm start continua usando o proxy local Angular; estas opções são de produção.

# Obrigatória no início do Node, sem /api ou credenciais; não fica embutida no Angular.
BACKEND_URL=https://singflow.onrender.com
# Hostinger fornece PORT automaticamente. Não definir no painel.
# PORT=3000

# Licença pública PrimeUI: override em runtime; no build usada só ao criar config.json.
PRIMEUI_LICENSE_KEY=
