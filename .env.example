# Local development only. Copy to .env and export before starting backend.
POSTGRES_DB=singflow
POSTGRES_USER=singflow
POSTGRES_PASSWORD=singflow_local
POSTGRES_PORT=55432
DB_URL=jdbc:postgresql://localhost:55432/singflow
DB_USERNAME=singflow
DB_PASSWORD=singflow_local

# Initial host account: supply your own password (12+ characters, at most 72 UTF-8 bytes).
# Existing accounts are never reset automatically on startup.
SINGFLOW_HOST_EMAIL=anfitriao@example.com
SINGFLOW_HOST_PASSWORD=
# Complete Docker stack (separate database volume from backend/compose.yaml)
WEB_PORT=8081

# Optional: explicit public frontend origin used in session links and QR codes.
# Native default: http://127.0.0.1:4200; Compose default follows WEB_PORT.
# SINGFLOW_PUBLIC_APP_URL=http://127.0.0.1:4200
SINGFLOW_ENTRY_LIMIT_PER_MINUTE=120
SINGFLOW_REQUEST_LIMIT_PER_MINUTE=20
SINGFLOW_READ_LIMIT_PER_MINUTE=120
