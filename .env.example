# SingFlow — modelo consolidado. Nunca importar o arquivo inteiro nos dois serviços.
# Valores abaixo são exemplos locais; no Render usar os valores de produção já configurados.
# Copiar apenas o bloco do serviço de destino. Segredos ficam fora do Git.

# ============================================================================
# 1. COMUNS A BACKEND E FRONTEND
# ============================================================================
# Hoje não há variável de negócio lida pelos dois processos.
# Manter as URLs no bloco de quem as consome; não duplicar credenciais do banco no frontend.
# Variáveis reais do serviço têm prioridade sobre seu .env local.

# ============================================================================
# 2. BACKEND — Render / inicializador Java local
# ============================================================================
# Render: SPRING_PROFILES_ACTIVE=prod. A classe local já ativa o perfil local.
# SPRING_PROFILES_ACTIVE=prod
# Porta do Java. PORT do bloco frontend não configura o Spring Boot.
# SERVER_PORT=8080

# Banco: em produção usar JDBC do Aiven com SSL, sem usuário/senha dentro da URL.
DB_URL=jdbc:postgresql://localhost:55432/singflow
DB_USERNAME=singflow
DB_PASSWORD=singflow_local

# Origem pública do FRONTEND, usada nos QR Codes e nos e-mails (não é a URL da API).
# Render: https://singflow.flowave.tec.br
# Local: o inicializador substitui loopback pelo IP da máquina.
# Compose: omitir para usar a porta WEB_PORT automaticamente.
# SINGFLOW_PUBLIC_APP_URL=http://127.0.0.1:4200

# Provisionamento inicial opcional. Contas existentes não têm a senha redefinida.
SINGFLOW_HOST_EMAIL=anfitriao@example.com
SINGFLOW_HOST_PASSWORD=
# E-mail de uma conta aprovada existente que receberá ADMIN; não cria nova conta.
SINGFLOW_ADMIN_EMAIL=

# SMTP e remetente — configurar provedor real em produção.
# Ensaio Mailpit local: host=127.0.0.1, porta=1025, auth=false, starttls=false.
SINGFLOW_SMTP_HOST=
SINGFLOW_SMTP_PORT=587
SINGFLOW_SMTP_USERNAME=
SINGFLOW_SMTP_PASSWORD=
SINGFLOW_SMTP_AUTH=true
SINGFLOW_SMTP_STARTTLS=true
SINGFLOW_MAIL_FROM=

# Last.fm e processamento da sincronização do catálogo (chave apenas no backend).
LASTFM_API_KEY=
SINGFLOW_CATALOG_SYNC_ENABLED=true

# Limites por minuto.
SINGFLOW_ENTRY_LIMIT_PER_MINUTE=120
SINGFLOW_REQUEST_LIMIT_PER_MINUTE=20
SINGFLOW_READ_LIMIT_PER_MINUTE=120
SINGFLOW_MUSICIAN_SIGNUP_LIMIT_PER_MINUTE=20

# PostgreSQL via Docker, apenas desenvolvimento; não importar no Render/Aiven.
POSTGRES_DB=singflow
POSTGRES_USER=singflow
POSTGRES_PASSWORD=singflow_local
POSTGRES_PORT=55432

# ============================================================================
# 3. FRONTEND — Hostinger Node.js / frontend/.env
# ============================================================================
# Obrigatória no início do servidor Node. Apenas origem, sem /api ou credenciais.
# Lida em runtime: mudar o backend requer reiniciar o Node, não recompilar Angular.
BACKEND_URL=https://singflow.onrender.com
# Hostinger fornece PORT automaticamente; não sobrescrever no painel.
# Para ensaio local com npm run start:prod:
# PORT=3000
# Opcional. Licença pública do frontend; não é senha do backend.
# No Node sobrescreve a licença do artefato ao iniciar.
# No build só é usada se public/config.json ainda não existir.
PRIMEUI_LICENSE_KEY=

# Porta HTTP do frontend Nginx no Compose local; não importar na Hostinger.
WEB_PORT=8081
