{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "SingFlow EC2 read-only access to the two application ECR repositories.",
  "Resources": {
    "PullImages": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "SingFlowPullReleaseImages",
        "Roles": ["singflow-trial-core-InstanceRole-gI8jlwKphE9e"],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "LoginToECRInOhio",
              "Effect": "Allow",
              "Action": "ecr:GetAuthorizationToken",
              "Resource": "*",
              "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-2"}}
            },
            {
              "Sid": "PullOnlySingFlowImages",
              "Effect": "Allow",
              "Action": ["ecr:BatchCheckLayerAvailability", "ecr:GetDownloadUrlForLayer", "ecr:BatchGetImage"],
              "Resource": [
                "arn:aws:ecr:us-east-2:505828739529:repository/singflow/backend",
                "arn:aws:ecr:us-east-2:505828739529:repository/singflow/frontend"
              ]
            }
          ]
        }
      }
    }
  }
}
